# Word caches are downloaded/rebuilt at runtime and not tracked — except the
# curated two-letter playability dataset, which is static (see its .md).
src/scrabble/cache/*
!src/scrabble/cache/two_letter_playability.tsv
!src/scrabble/cache/two_letter_playability.md

# macOS specific files
.DS_Store

# Python specific files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
*-env/
ENV/
env/
.venv/
.pyenv/
.Python

# Generated
src/scrabble/.cache.json

# Data for temporary agent reference
anki-docs/
tmp/

# Agent use
/memory/

# Broncos roster snapshot is refetched weekly at runtime; the committed
# seed_snapshot.json is the offline fallback.
src/broncos/cache/
